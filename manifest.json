{
  "manifest_version": 3,
  "name": "NU Laguna GWA Calculator",
  "version": "1.0",
  "description": "Calculates your Term and Cumulative GWA.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.nu-laguna.edu.ph/*"],
      "js": ["content.js"]
    }
  ]
}